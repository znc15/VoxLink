<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>VoxLink.Engine</AssemblyName>
    <RootNamespace>VoxLink.Engine</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- 与 UI 一致：发布产物预编译，缩短引擎冷启动 JIT（本地 build 不受影响）。 -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VoxLink\VoxLink.csproj" />
    <None Include="..\VoxLink\ThirdParty\OpenVR\openvr_api.dll"
          Link="openvr_api.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="ModelHost\**\*"
          Exclude="ModelHost\**\__pycache__\**;ModelHost\**\*.pyc;ModelHost\**\.ruff_cache\**"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
