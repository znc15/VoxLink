<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="VoxLink.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="VoxLink"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootLayout" RequestedTheme="Light">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title=" "
            Subtitle=" "
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False" />
        <Button
            x:Name="PaneToggleButton"
            Width="40"
            Height="40"
            Margin="8,4,0,0"
            Padding="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            CornerRadius="8"
            Click="PaneToggleButton_Click"
            ToolTipService.ToolTip="展开或收起导航">
            <FontIcon FontSize="16" Glyph="&#xE700;" />
        </Button>
        <StackPanel
            Margin="56,0,0,0"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="10">
            <Border
                Width="28"
                Height="28"
                Background="{StaticResource VoxLinkAccentBrush}"
                CornerRadius="{StaticResource VoxLinkRadiusSmall}">
                <FontIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="White"
                    FontSize="15"
                    Glyph="&#xE8C1;" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="0">
                <TextBlock FontSize="14" FontWeight="SemiBold" Text="VoxLink" />
                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="游戏实时翻译" />
            </StackPanel>
        </StackPanel>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            AlwaysShowHeader="False"
            CompactModeThresholdWidth="680"
            ExpandedModeThresholdWidth="1040"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="248"
            PaneDisplayMode="Auto"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.PaneHeader>
                <StackPanel Margin="12,8,8,8" Orientation="Horizontal" Spacing="10">
                    <Border
                        Width="32"
                        Height="32"
                        Background="{StaticResource VoxLinkAccentBrush}"
                        CornerRadius="{StaticResource VoxLinkRadiusSmall}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="White"
                            FontSize="17"
                            Glyph="&#xE8C1;" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="VoxLink" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="本地音频 · 在线翻译" />
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItemHeader Content="工作区" />
                <NavigationViewItem
                    x:Name="LiveNavigationItem"
                    Content="实时翻译"
                    IsSelected="True"
                    Tag="live">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE720;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="AI 与语音" Tag="providers">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE945;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="配置" />
                <NavigationViewItem Content="音频设备" Tag="audio">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE767;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="VRChat" Tag="vrchat">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="高级设置" Tag="advanced">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <Border
                    Margin="8,12"
                    Padding="10"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="{StaticResource VoxLinkRadiusSmall}">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Ellipse
                            x:Name="EngineStatusDot"
                            Width="8"
                            Height="8"
                            VerticalAlignment="Center"
                            Fill="{StaticResource VoxLinkWarningBrush}" />
                        <TextBlock
                            x:Name="EngineStatusText"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Text="正在连接音频引擎" />
                    </StackPanel>
                </Border>
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
