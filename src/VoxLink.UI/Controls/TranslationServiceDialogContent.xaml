<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="VoxLink.UI.Controls.TranslationServiceDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:VoxLink.UI.Controls">
    <ScrollViewer MaxHeight="560">
        <StackPanel MinWidth="430" Spacing="12">
            <PasswordBox
                x:Name="ApiKeyBox"
                Header="API Key"
                PasswordRevealMode="Peek"
                PlaceholderText="预置服务一般只填这里就行" />
            <ToggleSwitch x:Name="RefinementSwitch" Header="润色译文" OffContent="关闭" OnContent="开启" />
            <TextBox
                x:Name="RefinementPromptBox"
                AcceptsReturn="True"
                Header="润色要求"
                MaxHeight="100"
                PlaceholderText="可选"
                TextWrapping="Wrap" />
            <Expander x:Name="AdvancedExpander" Header="高级设置">
                <StackPanel Padding="0,10,0,0" Spacing="10">
                    <TextBox x:Name="BaseUrlBox" Header="服务地址" />
                    <TextBox x:Name="ModelBox" Header="模型" />
                    <controls:HeaderEditor x:Name="HeaderEditor" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
