<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="VoxLink.UI.Controls.SpeechServiceDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:VoxLink.UI.Controls">
    <ScrollViewer MaxHeight="560">
        <StackPanel MinWidth="430" Spacing="12">
            <TextBlock x:Name="NoConfigText" Text="系统语音不用额外配置，直接用。" />
            <StackPanel x:Name="KokoroPanel" Spacing="10" Visibility="Collapsed">
                <NumberBox
                    x:Name="SpeakerBox"
                    Header="音色 ID"
                    Minimum="0"
                    Maximum="102"
                    SpinButtonPlacementMode="Inline" />
                <NumberBox
                    x:Name="SpeedBox"
                    Header="语速"
                    Minimum="0.5"
                    Maximum="2"
                    SmallChange="0.1"
                    SpinButtonPlacementMode="Inline" />
            </StackPanel>
            <StackPanel x:Name="RemotePanel" Spacing="10" Visibility="Collapsed">
                <PasswordBox
                    x:Name="ApiKeyBox"
                    Header="API Key"
                    PasswordRevealMode="Peek"
                    PlaceholderText="预置服务通常只需填写此项" />
                <TextBox x:Name="VoiceBox" Header="音色" />
                <Expander Header="高级设置">
                    <StackPanel Padding="0,10,0,0" Spacing="10">
                        <ComboBox x:Name="ProtocolBox" Header="服务" SelectionChanged="ProtocolBox_SelectionChanged">
                            <ComboBoxItem Content="阿里云 DashScope" Tag="DashScope" />
                            <ComboBoxItem Content="小米 MiMo" Tag="MiMo" />
                            <ComboBoxItem Content="OpenAI 兼容" Tag="OpenAiCompatible" />
                        </ComboBox>
                        <TextBox x:Name="BaseUrlBox" Header="服务地址" />
                        <TextBox x:Name="ModelBox" Header="模型" />
                        <controls:HeaderEditor x:Name="HeaderEditor" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
