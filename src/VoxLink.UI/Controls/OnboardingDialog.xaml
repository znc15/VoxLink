<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="VoxLink.UI.Controls.OnboardingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="RootDialog"
    Title="VoxLink 新手引导"
    CloseButtonText="稍后"
    CloseButtonStyle="{StaticResource RoundedButtonStyle}"
    PrimaryButtonStyle="{StaticResource RoundedButtonStyle}"
    SecondaryButtonStyle="{StaticResource RoundedButtonStyle}"
    DefaultButton="Primary"
    PrimaryButtonClick="Dialog_PrimaryButtonClick"
    SecondaryButtonClick="Dialog_SecondaryButtonClick">
    <ScrollViewer MaxHeight="560" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="520" MinWidth="420" Spacing="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StepTitleText" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="StepCounterText" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" />
            </Grid>

            <InfoBar
                x:Name="GuideErrorBar"
                IsClosable="False"
                IsOpen="False"
                Severity="Warning" />

            <StackPanel x:Name="DevicesStep" Spacing="14">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        x:Name="MyLanguageBox"
                        Header="我的语言"
                        DisplayMemberPath="DisplayName"
                        SelectedValuePath="Code" />
                    <Button
                        Grid.Column="1"
                        Width="32"
                        Height="32"
                        Padding="0"
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalAlignment="Bottom"
                        VerticalContentAlignment="Center"
                        Click="SwapLanguages_Click"
                        ToolTipService.ToolTip="交换语言">
                        <FontIcon FontSize="14" Glyph="&#xE8AB;" />
                    </Button>
                    <ComboBox
                        x:Name="OtherLanguageBox"
                        Grid.Column="2"
                        Header="对方语言"
                        DisplayMemberPath="DisplayName"
                        SelectedValuePath="Code" />
                </Grid>

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        x:Name="MicrophoneBox"
                        Header="麦克风输入"
                        DisplayMemberPath="Label"
                        SelectedValuePath="Id" />
                    <Button Grid.Column="1" Margin="0,18,0,0" Click="RefreshDevices_Click" ToolTipService.ToolTip="刷新设备">
                        <FontIcon Glyph="&#xE72C;" />
                    </Button>
                </Grid>

                <StackPanel x:Name="VoiceSettingsPanel" Spacing="12">
                    <InfoBar
                        x:Name="VirtualCableInfoBar"
                        IsClosable="False"
                        IsOpen="True" />
                    <ComboBox
                        x:Name="VoiceOutputBox"
                        Header="VoxLink 语音输出（虚拟声卡播放端）"
                        DisplayMemberPath="Label"
                        SelectedValuePath="Id"
                        SelectionChanged="VoiceOutputBox_SelectionChanged" />
                    <RadioButtons x:Name="SpeechContentButtons" Header="我说话时朗读的内容" MaxColumns="2">
                        <RadioButton Content="朗读译文" Tag="Translation" />
                        <RadioButton Content="朗读原话" Tag="Original" />
                    </RadioButtons>
                    <HyperlinkButton Padding="0" Click="OpenVirtualCableDownload_Click" Content="打开 VB-CABLE 官方下载页" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="TestStep" Spacing="14" Visibility="Collapsed">
                <InfoBar
                    IsClosable="False"
                    IsOpen="True"
                    Message="在 VRChat 的 Action Menu → Options → OSC 中启用 OSC。Chatbox 测试会发送一条可见消息。"
                    Severity="Informational"
                    Title="启用 VRChat OSC" />
                <StackPanel x:Name="VoiceVrChatInstructions" Spacing="8" Visibility="Collapsed">
                    <InfoBar
                        IsClosable="False"
                        IsOpen="True"
                        Message="在 VRChat 设置 → Audio → Microphone 中选择虚拟声卡的录音端，例如 CABLE Output。VoxLink 选择的是配对的播放端 CABLE Input。"
                        Severity="Informational"
                        Title="选择 VRChat 麦克风" />
                </StackPanel>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="TestOscButton" Click="TestOsc_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="13" Glyph="&#xE724;" />
                            <TextBlock Text="测试 Chatbox" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="TestVoiceButton" Grid.Column="1" Click="TestVoice_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="13" Glyph="&#xE767;" />
                            <TextBlock Text="测试语音路由" />
                        </StackPanel>
                    </Button>
                    <ProgressRing x:Name="TestProgress" Grid.Column="2" Width="20" Height="20" HorizontalAlignment="Left" IsActive="False" Visibility="Collapsed" />
                </Grid>
                <TextBlock x:Name="TestStatusText" Style="{StaticResource CaptionStyle}" Text="测试完成后即可开启翻译。" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
