<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="VoxLink.UI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="VoxLinkAccentBrush" Color="#006F62" />
                    <SolidColorBrush x:Key="VoxLinkAccentSoftBrush" Color="#DDF3EE" />
                    <SolidColorBrush x:Key="VoxLinkSuccessBrush" Color="#107C41" />
                    <SolidColorBrush x:Key="VoxLinkWarningBrush" Color="#9A5B00" />
                    <SolidColorBrush x:Key="VoxLinkCriticalBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="VoxLinkMutedBrush" Color="#66706E" />
                    <SolidColorBrush x:Key="VoxLinkSurfaceBrush" Color="#FDFDFD" />
                    <SolidColorBrush x:Key="VoxLinkSurfaceSecondaryBrush" Color="#F3F6F5" />
                    <SolidColorBrush x:Key="VoxLinkStrokeBrush" Color="#16000000" />
                    <SolidColorBrush x:Key="VoxLinkTintStrokeBrush" Color="#6EB9AA" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="VoxLinkAccentBrush" Color="#62D7C2" />
                    <SolidColorBrush x:Key="VoxLinkAccentSoftBrush" Color="#1C3C37" />
                    <SolidColorBrush x:Key="VoxLinkSuccessBrush" Color="#68D391" />
                    <SolidColorBrush x:Key="VoxLinkWarningBrush" Color="#F2BE63" />
                    <SolidColorBrush x:Key="VoxLinkCriticalBrush" Color="#FF8A80" />
                    <SolidColorBrush x:Key="VoxLinkMutedBrush" Color="#A7B0AE" />
                    <SolidColorBrush x:Key="VoxLinkSurfaceBrush" Color="#E61E2221" />
                    <SolidColorBrush x:Key="VoxLinkSurfaceSecondaryBrush" Color="#B8242928" />
                    <SolidColorBrush x:Key="VoxLinkStrokeBrush" Color="#20FFFFFF" />
                    <SolidColorBrush x:Key="VoxLinkTintStrokeBrush" Color="#437C72" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <CornerRadius x:Key="VoxLinkRadiusSmall">6</CornerRadius>
            <CornerRadius x:Key="VoxLinkRadiusMedium">8</CornerRadius>
            <CornerRadius x:Key="VoxLinkRadiusLarge">12</CornerRadius>

            <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

            <Style x:Key="PanelBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource VoxLinkSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource VoxLinkStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource VoxLinkRadiusMedium}" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style x:Key="PageScrollViewerStyle" TargetType="ScrollViewer">
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="VerticalScrollMode" Value="Auto" />
            </Style>

            <Style x:Key="PageStackStyle" TargetType="StackPanel">
                <Setter Property="Padding" Value="28,24,28,32" />
                <Setter Property="Spacing" Value="16" />
                <Setter Property="MaxWidth" Value="1180" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="CaptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="RoundedButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="CornerRadius" Value="{StaticResource VoxLinkRadiusSmall}" />
                <Setter Property="Padding" Value="12,7" />
            </Style>

            <Style x:Key="HelpBadgeButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="{StaticResource VoxLinkRadiusSmall}" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
