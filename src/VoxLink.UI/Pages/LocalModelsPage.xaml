<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VoxLink.UI.Pages.LocalModelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:VoxLink.UI.Core.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Page.Resources>
        <DataTemplate x:Key="LocalModelRowTemplate" x:DataType="models:LocalModelItem">
            <Grid Padding="12,10" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind DownloadSizeLabel}" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind InstallStateLabel, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind OperationStatus, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>

                <ProgressRing
                    Grid.Column="1"
                    Width="18"
                    Height="18"
                    IsActive="{x:Bind IsBusy, Mode=OneWay}" />
                <Button
                    Grid.Column="2"
                    MinWidth="106"
                    Click="ModelPrimaryAction_Click"
                    Content="{x:Bind PrimaryActionLabel, Mode=OneWay}"
                    IsEnabled="{x:Bind CanRunPrimaryAction, Mode=OneWay}" />
                <Button
                    Grid.Column="3"
                    Click="ModelSettings_Click"
                    Content="设置"
                    Tag="{x:Bind Id}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel Style="{StaticResource PageStackStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="本地模型" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="安装后自动启用，无需配置运行时" />
                </StackPanel>
                <Button
                    x:Name="RefreshLocalModelsButton"
                    Grid.Column="1"
                    Click="RefreshLocalModels_Click"
                    ToolTipService.ToolTip="刷新安装状态">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                </Button>
            </Grid>

            <InfoBar
                x:Name="ModelErrorBar"
                IsClosable="True"
                IsOpen="False"
                Severity="Error"
                Closed="ModelErrorBar_Closed" />
            <InfoBar
                x:Name="ModelResultBar"
                IsClosable="False"
                IsOpen="False"
                Severity="Success" />
            <InfoBar
                x:Name="RestartInfoBar"
                IsClosable="False"
                IsOpen="False"
                Message="当前会话仍使用原模型，停止并重新启动后应用新选择。"
                Severity="Informational"
                Title="需要重新启动会话" />

            <Border Style="{StaticResource PanelBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="一键本地模式" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="准备识别、翻译和语音模型，然后启动 VoxLink" />
                    </StackPanel>
                    <Button
                        x:Name="InstallRecommendedButton"
                        Grid.Column="1"
                        Click="InstallRecommended_Click"
                        Content="一键安装并启动" />
                </Grid>
            </Border>

            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="语音识别" />
                    <ListView
                        HorizontalContentAlignment="Stretch"
                        ItemTemplate="{StaticResource LocalModelRowTemplate}"
                        ItemsSource="{x:Bind Controller.SpeechRecognitionModels, Mode=OneWay}"
                        SelectionMode="None" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="翻译" />
                    <ListView
                        HorizontalContentAlignment="Stretch"
                        ItemTemplate="{StaticResource LocalModelRowTemplate}"
                        ItemsSource="{x:Bind Controller.TranslationModels, Mode=OneWay}"
                        SelectionMode="None" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="语音合成" />
                    <ListView
                        HorizontalContentAlignment="Stretch"
                        ItemTemplate="{StaticResource LocalModelRowTemplate}"
                        ItemsSource="{x:Bind Controller.SpeechSynthesisModels, Mode=OneWay}"
                        SelectionMode="None" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
