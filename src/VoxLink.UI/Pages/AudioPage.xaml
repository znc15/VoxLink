<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VoxLink.UI.Pages.AudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d"
    NavigationCacheMode="Required">
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel Style="{StaticResource PageStackStyle}">
            <StackPanel Spacing="3">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="音频设备" />
                <TextBlock Style="{StaticResource CaptionStyle}" Text="配置采集来源、设备路由与断句行为" />
            </StackPanel>

            <InfoBar
                x:Name="AudioErrorBar"
                IsClosable="True"
                IsOpen="False"
                Severity="Error"
                Closed="AudioErrorBar_Closed" />
        <InfoBar
            x:Name="RestartHintBar"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning"
            Message="采集来源或设备已更改，重新开始会话后生效。" />

            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="设备路由" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="留空时使用 Windows 默认设备。" />
                        </StackPanel>
                        <Button Grid.Column="1" Click="RefreshDevices_Click">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon FontSize="13" Glyph="&#xE72C;" />
                                <TextBlock Text="刷新设备" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ToggleSwitch
                        Header="采集麦克风"
                        IsOn="{x:Bind Controller.Settings.CaptureMicrophone, Mode=TwoWay}"
                        OffContent="关闭"
                        OnContent="开启" />
                    <ComboBox
                        x:Name="MicrophoneBox"
                        Header="麦克风输入"
                        DisplayMemberPath="Label"
                        IsEnabled="{x:Bind Controller.Settings.CaptureMicrophone, Mode=OneWay}"
                        ItemsSource="{x:Bind Controller.MicrophoneDevices}"
                        SelectedValuePath="Id"
                        SelectionChanged="Device_SelectionChanged" />
                    <ToggleSwitch
                        Header="采集系统音频回环"
                        IsOn="{x:Bind Controller.Settings.CaptureSystemAudio, Mode=TwoWay}"
                        OffContent="关闭"
                        OnContent="开启" />
                    <ComboBox
                        x:Name="LoopbackBox"
                        Header="系统音频回环"
                        DisplayMemberPath="Label"
                        IsEnabled="{x:Bind Controller.Settings.CaptureSystemAudio, Mode=OneWay}"
                        ItemsSource="{x:Bind Controller.RenderDevices}"
                        SelectedValuePath="Id"
                        SelectionChanged="Device_SelectionChanged" />
                    <ComboBox
                        x:Name="VoiceOutputBox"
                        Header="语音输出"
                        DisplayMemberPath="Label"
                        ItemsSource="{x:Bind Controller.RenderDevices}"
                        SelectedValuePath="Id"
                        SelectionChanged="Device_SelectionChanged" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="语音活动检测" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="环境噪声较大时提高阈值，语句容易截断时延长静音时间。" />
                    </StackPanel>
                    <ToggleSwitch
                        Header="智能断句"
                        IsOn="{x:Bind Controller.Settings.SmartSentenceSegmentation, Mode=TwoWay}"
                        OffContent="固定静音阈值"
                        OnContent="语义断句" />
                    <StackPanel Spacing="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="触发阈值" />
                            <TextBlock x:Name="ThresholdValueText" Grid.Column="1" Style="{StaticResource CaptionStyle}" />
                        </Grid>
                        <Slider
                            x:Name="ThresholdSlider"
                            Maximum="0.08"
                            Minimum="0.005"
                            SmallChange="0.001"
                            StepFrequency="0.001"
                            Value="{x:Bind Controller.Settings.VoiceThreshold, Mode=TwoWay}"
                            ValueChanged="ThresholdSlider_ValueChanged" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="断句静音时长" />
                            <TextBlock x:Name="SilenceValueText" Grid.Column="1" Style="{StaticResource CaptionStyle}" />
                        </Grid>
                        <Slider
                            x:Name="SilenceSlider"
                            Maximum="1800"
                            Minimum="300"
                            SmallChange="50"
                            StepFrequency="50"
                            Value="{x:Bind Controller.Settings.SilenceDurationMs, Mode=TwoWay}"
                            ValueChanged="SilenceSlider_ValueChanged" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
