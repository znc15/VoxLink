<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VoxLink.UI.Pages.ConversationHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:VoxLink.UI.Core.Models"
    Background="Transparent"
    mc:Ignorable="d"
    NavigationCacheMode="Required">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="28,24,28,14" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="会话记录" />
                <TextBlock
                    Style="{StaticResource CaptionStyle}"
                    Text="查看本次运行期间的全部实时翻译与手动输入记录" />
            </StackPanel>
            <Button
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Click="ClearMessages_Click"
                ToolTipService.ToolTip="清空会话记录">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon FontSize="13" Glyph="&#xE74D;" />
                    <TextBlock Text="清空" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Padding="28,0,28,28">
            <StackPanel
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <FontIcon
                    FontSize="20"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE8BD;" />
                <StackPanel Spacing="2">
                    <TextBlock FontWeight="SemiBold" Text="暂无会话记录" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="开始软件或输入文字后会显示在这里" />
                </StackPanel>
            </StackPanel>

            <ListView
                x:Name="ConversationList"
                ItemsSource="{x:Bind Controller.Messages}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ConversationMessage">
                        <Border
                            Margin="0,0,0,8"
                            Padding="14,12"
                            Background="{ThemeResource VoxLinkSurfaceBrush}"
                            BorderBrush="{ThemeResource VoxLinkStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource VoxLinkRadiusMedium}">
                            <Grid Padding="0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="36"
                                    Height="36"
                                    Background="{ThemeResource VoxLinkAccentSoftBrush}"
                                    CornerRadius="{StaticResource VoxLinkRadiusSmall}">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource VoxLinkAccentBrush}"
                                        FontSize="16"
                                        Glyph="{x:Bind DirectionGlyph}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="{x:Bind HeaderLabel}" />
                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind TimeLabel}" />
                                    </StackPanel>
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="{x:Bind PrimaryDisplayText}" TextWrapping="Wrap" />
                                    <TextBlock Foreground="{ThemeResource VoxLinkAccentBrush}" FontSize="13" Text="{x:Bind SecondaryDisplayText}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind SourceDisplayText}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="2"
                                    VerticalAlignment="Top"
                                    Click="SpeakMessage_Click"
                                    IsEnabled="{x:Bind CanSpeak}"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="朗读译文">
                                    <FontIcon FontSize="14" Glyph="&#xE767;" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
