<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VoxLink.UI.Pages.ModelProvidersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel Style="{StaticResource PageStackStyle}">
            <StackPanel Spacing="3">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="模型服务" />
                <TextBlock Style="{StaticResource CaptionStyle}" Text="翻译、识别、语音，各选一个就能用" />
            </StackPanel>

            <InfoBar
                x:Name="ProviderErrorBar"
                IsClosable="True"
                IsOpen="False"
                Severity="Error"
                Closed="ProviderErrorBar_Closed" />
            <InfoBar
                x:Name="ProviderResultBar"
                IsClosable="False"
                IsOpen="False"
                Severity="Success" />
            <InfoBar
                x:Name="RestartInfoBar"
                IsClosable="False"
                IsOpen="False"
                Message="当前会话还在用旧服务，停掉重开就切换了。"
                Severity="Informational"
                Title="重启会话后生效" />

            <Border Style="{StaticResource PanelBorderStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="翻译" />
                            <TextBlock x:Name="TranslationStatusText" Style="{StaticResource CaptionStyle}" Text="无需配置" />
                        </StackPanel>
                        <Button
                            x:Name="ConfigureTranslationButton"
                            Grid.Column="1"
                            Click="ConfigureTranslation_Click"
                            Content="设置" />
                    </Grid>
                    <ComboBox
                        x:Name="TranslationBackendBox"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        MaxDropDownHeight="320"
                                                SelectionChanged="TranslationBackendBox_SelectionChanged">
                        <ComboBoxItem Content="公共免密" Tag="PublicFree" />
                        <ComboBoxItem x:Name="HyMtGgufOption" Content="本地混元翻译 HY-MT1.5-1.8B（GGUF）" Tag="LocalHyMtGguf" />
                        <ComboBoxItem x:Name="MiniCpmOption" Content="本地 MiniCPM5-1B" Tag="LocalMiniCpm" />
                        <ComboBoxItem Content="DeepSeek" Tag="DeepSeek" />
                        <ComboBoxItem Content="OpenAI 兼容" Tag="OpenAiCompatible" />
                        <ComboBoxItem Content="自定义服务" Tag="Custom" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource PanelBorderStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="语音识别" />
                            <TextBlock x:Name="AsrStatusText" Style="{StaticResource CaptionStyle}" Text="本地处理" />
                        </StackPanel>
                        <Button
                            x:Name="ConfigureAsrButton"
                            Grid.Column="1"
                            Click="ConfigureAsr_Click"
                            Content="设置" />
                    </Grid>
                    <ComboBox
                        x:Name="AsrProviderBox"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        MaxDropDownHeight="320"
                                                SelectionChanged="AsrProviderBox_SelectionChanged">
                        <ComboBoxItem x:Name="WhisperBaseOption" Content="Whisper base（推荐）" Tag="WhisperBase" />
                        <ComboBoxItem x:Name="WhisperLargeV3TurboOption" Content="Whisper large-v3-turbo（最准确）" Tag="WhisperLargeV3Turbo" />
                        <ComboBoxItem x:Name="SenseVoiceOption" Content="本地 SenseVoice（更快出字）" Tag="SenseVoice" />
                        <ComboBoxItem x:Name="FireRedAsr2CtcOption" Content="FireRedASR2-CTC（最准确）" Tag="FireRedAsr2Ctc" />
                        <ComboBoxItem Content="Soniox" Tag="Soniox" />
                        <ComboBoxItem Content="硅基流动" Tag="SiliconFlow" />
                        <ComboBoxItem Content="小米 MiMo" Tag="MiMo" />
                        <ComboBoxItem Content="OpenAI 兼容" Tag="OpenAiCompatible" />
                        <ComboBoxItem Content="自定义服务" Tag="Custom" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource PanelBorderStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="语音合成" />
                            <TextBlock x:Name="SpeechStatusText" Style="{StaticResource CaptionStyle}" Text="系统语音" />
                        </StackPanel>
                        <Button
                            x:Name="ConfigureSpeechButton"
                            Grid.Column="1"
                            Click="ConfigureSpeech_Click"
                            Content="设置" />
                    </Grid>
                    <ComboBox
                        x:Name="SpeechServiceBox"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        MaxDropDownHeight="320"
                                                SelectionChanged="SpeechServiceBox_SelectionChanged">
                        <ComboBoxItem Content="系统语音" Tag="SystemFallback" />
                        <ComboBoxItem x:Name="KokoroOption" Content="本地 Kokoro-82M" Tag="Kokoro" />
                        <ComboBoxItem Content="远程语音服务" Tag="Remote" />
                    </ComboBox>
                </Grid>
            </Border>

            <Button
                HorizontalAlignment="Left"
                Click="OpenLocalModels_Click"
                Content="管理本地模型" />
        </StackPanel>
    </ScrollViewer>
</Page>
