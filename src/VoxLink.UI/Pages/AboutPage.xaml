<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VoxLink.UI.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d"
    NavigationCacheMode="Required">
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel Style="{StaticResource PageStackStyle}">
            <StackPanel Spacing="3">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="关于" />
                <TextBlock
                    Style="{StaticResource CaptionStyle}"
                    Text="版本信息、更新检查与软件运行状态" />
            </StackPanel>

            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="版本与更新" />
                    </StackPanel>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="VersionText" FontWeight="SemiBold" />
                            <TextBlock x:Name="UpdateStatusText" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CheckUpdatesButton" Click="CheckForUpdates_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon FontSize="13" Glyph="&#xE72C;" />
                                    <TextBlock Text="检查更新" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="OpenReleaseButton" Click="OpenRelease_Click" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon FontSize="13" Glyph="&#xE8A7;" />
                                    <TextBlock Text="打开下载页" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        <Border Style="{StaticResource PanelBorderStyle}">
            <StackPanel Spacing="14">
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="运行状态" />
                <Grid RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="音频引擎" />
                    <TextBlock x:Name="EngineStateText" Grid.Column="1" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="翻译会话" />
                    <TextBlock x:Name="SessionStateText" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="2" Text="当前活动" />
                    <TextBlock x:Name="ActivityText" Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" />
                </Grid>
                <Button HorizontalAlignment="Left" Click="OpenOnboarding_Click">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="13" Glyph="&#xE897;" />
                        <TextBlock Text="重新打开新手引导" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
