<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VoxLink.UI.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d"
    NavigationCacheMode="Required">
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel Style="{StaticResource PageStackStyle}">
            <StackPanel Spacing="3">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="关于" />
                <TextBlock
                    Style="{StaticResource CaptionStyle}"
                    Text="版本信息、更新检查与软件运行状态" />
            </StackPanel>

            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="VoxLink — 面向 Windows 的双向实时语音翻译桌面应用"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Style="{StaticResource CaptionStyle}"
                        Text="识别麦克风与系统语音，把译文发送到 VRChat Chatbox 或经虚拟声卡送入游戏麦克风；内置本地 Whisper / MiniCPM / Kokoro 模型，支持桌面字幕与 SteamVR 头显字幕。"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="Windows 10/11 x64 · .NET 10 · WinUI 3 / Windows App SDK" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="版本与更新" />
                    </StackPanel>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="VersionText" FontWeight="SemiBold" />
                            <TextBlock x:Name="UpdateStatusText" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CheckUpdatesButton" Click="CheckForUpdates_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon FontSize="13" Glyph="&#xE72C;" />
                                    <TextBlock Text="检查更新" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="OpenReleaseButton" Click="OpenRelease_Click" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon FontSize="13" Glyph="&#xE8A7;" />
                                    <TextBlock Text="打开下载页" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="项目与帮助" />
                    <HyperlinkButton HorizontalAlignment="Left" Click="OpenGitHub_Click" Padding="0">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="13" Glyph="&#xE774;" />
                            <TextBlock Text="GitHub 仓库（源码与使用文档）" />
                        </StackPanel>
                    </HyperlinkButton>
                    <HyperlinkButton HorizontalAlignment="Left" Click="OpenReleases_Click" Padding="0">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="13" Glyph="&#xE8A7;" />
                            <TextBlock Text="Releases 下载与更新日志" />
                        </StackPanel>
                    </HyperlinkButton>
                    <HyperlinkButton HorizontalAlignment="Left" Click="OpenIssues_Click" Padding="0">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="13" Glyph="&#xE7BA;" />
                            <TextBlock Text="报告问题（GitHub Issues）" />
                        </StackPanel>
                    </HyperlinkButton>
                    <HyperlinkButton HorizontalAlignment="Left" Click="OpenSite_Click" Padding="0">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="13" Glyph="&#xE774;" />
                            <TextBlock Text="项目主页" />
                        </StackPanel>
                    </HyperlinkButton>
                </StackPanel>
            </Border>

        <Border Style="{StaticResource PanelBorderStyle}">
            <StackPanel Spacing="14">
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="运行状态" />
                <Grid RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="音频引擎" />
                    <TextBlock x:Name="EngineStateText" Grid.Column="1" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="翻译会话" />
                    <TextBlock x:Name="SessionStateText" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="2" Text="当前活动" />
                    <TextBlock x:Name="ActivityText" Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" />
                </Grid>
                <Button HorizontalAlignment="Left" Click="OpenOnboarding_Click">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="13" Glyph="&#xE897;" />
                        <TextBlock Text="重新打开新手引导" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="许可与声明" />
                    <TextBlock
                        Style="{StaticResource CaptionStyle}"
                        Text="VoxLink 使用 MIT License 发布，内置 Whisper.cpp、LLamaSharp、sherpa-onnx 等第三方组件。"
                        TextWrapping="Wrap" />
                    <HyperlinkButton HorizontalAlignment="Left" Click="OpenLicense_Click" Padding="0">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="13" Glyph="&#xE8A1;" />
                            <TextBlock Text="查看 MIT License" />
                        </StackPanel>
                    </HyperlinkButton>
                    <HyperlinkButton HorizontalAlignment="Left" Click="OpenThirdPartyNotices_Click" Padding="0">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="13" Glyph="&#xE8A1;" />
                            <TextBlock Text="第三方组件声明（THIRD-PARTY-NOTICES）" />
                        </StackPanel>
                    </HyperlinkButton>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
