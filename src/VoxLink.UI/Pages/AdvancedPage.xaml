<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VoxLink.UI.Pages.AdvancedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:VoxLink.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d"
    NavigationCacheMode="Required">
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel Style="{StaticResource PageStackStyle}">
            <StackPanel Spacing="3">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="高级设置" />
                <TextBlock Style="{StaticResource CaptionStyle}" Text="转写模式、全局快捷键与窗口外观" />
            </StackPanel>

            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="会话行为" />
                    <ToggleSwitch
                        Header="仅转写"
                        IsOn="{x:Bind Controller.Settings.TranscriptionOnly, Mode=TwoWay}"
                        OffContent="识别并翻译"
                        OnContent="只显示原文" />
                    <TextBlock
                        Style="{StaticResource CaptionStyle}"
                        Text="开启后仅识别并显示原文，不做翻译、不发送 Chatbox、不朗读语音，可作纯语音转写使用；关闭则恢复完整的识别 → 翻译 → 发送链路。会话行为开关用于在不想打扰对方或网络/服务不可用时快速切换为本地听写。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="全局快捷键" />
                    <controls:HotkeyRecorder
                        Title="开始 / 停止会话"
                        Hotkey="{x:Bind Controller.Settings.ToggleHotkey, Mode=TwoWay}" />
                    <controls:HotkeyRecorder
                        Title="翻译当前输入"
                        Hotkey="{x:Bind Controller.Settings.TranslateHotkey, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="窗口与退出" />
                    <ToggleSwitch
                        Header="最小化到系统托盘"
                        IsOn="{x:Bind Controller.Settings.MinimizeToTray, Mode=TwoWay}"
                        OffContent="普通最小化"
                        OnContent="后台运行" />
                    <ToggleSwitch
                        Header="关闭前询问"
                        IsOn="{x:Bind Controller.Settings.ConfirmOnClose, Mode=TwoWay}"
                        OffContent="直接关闭"
                        OnContent="询问隐藏到托盘" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="外观" />
                    <ToggleSwitch
                        Header="Mica 透明背景"
                        IsOn="{x:Bind Controller.Settings.UseMicaBackdrop, Mode=TwoWay}"
                        OffContent="纯色背景"
                        OnContent="Mica" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="本地模型存储" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="留空使用默认位置；更改后重新启动 VoxLink 生效。" />
                    </StackPanel>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="LocalModelDirectoryBox"
                            Header="本地模型保存位置"
                            PlaceholderText="留空使用默认位置"
                            Text="{x:Bind Controller.Settings.LocalModelDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="1"
                            MinHeight="32"
                            Margin="8,0,0,0"
                            VerticalAlignment="Bottom"
                            Click="BrowseLocalModelDirectory_Click"
                            Content="浏览…"
                            ToolTipService.ToolTip="用系统文件管理器选择本地模型存储位置" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="ManagedRuntimeDirectoryBox"
                            Header="托管运行时保存位置"
                            PlaceholderText="留空使用默认位置"
                            Text="{x:Bind Controller.Settings.ManagedRuntimeDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="1"
                            MinHeight="32"
                            Margin="8,0,0,0"
                            VerticalAlignment="Bottom"
                            Click="BrowseManagedRuntimeDirectory_Click"
                            Content="浏览…"
                            ToolTipService.ToolTip="用系统文件管理器选择托管运行时存储位置" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
