<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VoxLink.UI.Pages.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:VoxLink.UI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:VoxLink.UI.Core.Services"
    Background="Transparent"
    mc:Ignorable="d"
    NavigationCacheMode="Required">
    <Page.Resources>
        <local:LogTimeConverter x:Key="LogTimeConverter" />
        <local:LogLevelToBrushConverter x:Key="LogLevelToBrushConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="28,24,28,14" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="日志" />
                <TextBlock
                    Style="{StaticResource CaptionStyle}"
                    Text="排查翻译、引擎与服务连接问题；日志同时写入 %APPDATA%\VoxLink\logs。" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="8">
                <ComboBox
                    x:Name="LevelFilterBox"
                    MinWidth="120"
                    Header="显示级别"
                    SelectionChanged="LevelFilterBox_SelectionChanged">
                    <ComboBoxItem Content="全部（含调试）" />
                    <ComboBoxItem Content="信息以上" />
                    <ComboBoxItem Content="警告以上" />
                    <ComboBoxItem Content="仅错误" />
                </ComboBox>
                <Button
                    VerticalAlignment="Bottom"
                    Click="Copy_Click"
                    ToolTipService.ToolTip="复制当前筛选结果到剪贴板">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="13" Glyph="&#xE8C8;" />
                        <TextBlock Text="复制" />
                    </StackPanel>
                </Button>
                <Button
                    VerticalAlignment="Bottom"
                    Click="OpenFolder_Click"
                    ToolTipService.ToolTip="打开日志文件夹">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="13" Glyph="&#xE8DA;" />
                        <TextBlock Text="文件夹" />
                    </StackPanel>
                </Button>
                <Button
                    VerticalAlignment="Bottom"
                    Click="Clear_Click"
                    ToolTipService.ToolTip="清空内存日志（不影响磁盘文件）">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="13" Glyph="&#xE74D;" />
                        <TextBlock Text="清空" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="1"
            Margin="28,0,28,24"
            Padding="0"
            Style="{StaticResource PanelBorderStyle}">
            <ListView
                x:Name="LogList"
                Padding="4,0"
                Background="Transparent"
                IsItemClickEnabled="False"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="services:LogEntry">
                        <Border Padding="14,5" BorderBrush="{ThemeResource VoxLinkStrokeBrush}" BorderThickness="0,0,0,1">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind Timestamp, Converter={StaticResource LogTimeConverter}, Mode=OneTime}"
                                    VerticalAlignment="Top" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{x:Bind Level, Converter={StaticResource LogLevelToBrushConverter}, Mode=OneTime}"
                                    Text="{x:Bind services:LogService.LevelDisplayName(Level), Mode=OneTime}"
                                    VerticalAlignment="Top" />
                                <TextBlock
                                    Grid.Column="2"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Source}"
                                    VerticalAlignment="Top" />
                                <TextBlock
                                    Grid.Column="3"
                                    FontFamily="Consolas"
                                    FontSize="12.5"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind Message}"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <StackPanel
            x:Name="EmptyState"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="Collapsed">
            <FontIcon
                FontSize="22"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE7BC;" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="暂无日志" />
        </StackPanel>
    </Grid>
</Page>
