<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VoxLink.UI.Pages.LivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:models="using:VoxLink.UI.Core.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d"
    NavigationCacheMode="Required">
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel Style="{StaticResource PageStackStyle}">

        <StackPanel Spacing="3">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="实时翻译" />
            <TextBlock
                Style="{StaticResource CaptionStyle}"
                Text="识别麦克风并将译文发送到 VRChat" />
        </StackPanel>

        <InfoBar
            x:Name="UpdateInfoBar"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="False"
            Severity="Informational"
            Visibility="Collapsed"
            Closed="UpdateInfoBar_Closed">
            <InfoBar.ActionButton>
                <Button Content="打开下载页" Click="OpenRelease_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <InfoBar
            x:Name="RestartHintBar"
            Grid.Row="2"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning"
            Visibility="Collapsed"
            Message="采集来源或设备已更改，重新开始会话后生效。" />

        <InfoBar
            x:Name="WarningInfoBar"
            IsClosable="True"
            IsOpen="False"
            Severity="Warning"
            Visibility="Collapsed"
            Closed="WarningInfoBar_Closed" />

        <InfoBar
            x:Name="ErrorInfoBar"
            Grid.Row="3"
            IsClosable="True"
            IsOpen="False"
            Severity="Error"
            Visibility="Collapsed"
            Closed="ErrorInfoBar_Closed" />


        <Border Grid.Row="4" Style="{StaticResource PanelBorderStyle}">
            <Grid
                x:Name="LanguageGrid"
                ColumnSpacing="12"
                RowSpacing="10"
                SizeChanged="LanguageGrid_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FirstLanguageColumn" Width="*" />
                    <ColumnDefinition x:Name="SwapColumn" Width="44" />
                    <ColumnDefinition x:Name="SecondLanguageColumn" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ComboBox
                    x:Name="MyLanguageBox"
                    Header="我的语言"
                    DisplayMemberPath="DisplayName"
                    ItemsSource="{x:Bind Controller.Languages}"
                    SelectedValue="{x:Bind Controller.Settings.MyLanguageCode, Mode=TwoWay}"
                    SelectedValuePath="Code"
                    SelectionChanged="Language_SelectionChanged" />
                <Button
                    x:Name="SwapButton"
                    Grid.Column="1"
                    Width="32"
                    Height="32"
                    Padding="0"
                    HorizontalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalAlignment="Bottom"
                    VerticalContentAlignment="Center"
                    Click="SwapButton_Click"
                    ToolTipService.ToolTip="交换语言">
                    <FontIcon FontSize="14" Glyph="&#xE8AB;" />
                </Button>
                <ComboBox
                    x:Name="OtherLanguageBox"
                    Grid.Column="2"
                    Header="对方语言"
                    DisplayMemberPath="DisplayName"
                    ItemsSource="{x:Bind Controller.Languages}"
                    SelectedValue="{x:Bind Controller.Settings.OtherLanguageCode, Mode=TwoWay}"
                    SelectedValuePath="Code"
                    SelectionChanged="Language_SelectionChanged" />
                <ComboBox
                    x:Name="SecondaryLanguageBox"
                    Grid.Row="1"
                    Grid.Column="2"
                    Header="第二目标语言"
                    DisplayMemberPath="DisplayName"
                    ItemsSource="{x:Bind Controller.SecondaryLanguages}"
                    SelectedValue="{x:Bind Controller.Settings.SecondaryTargetLanguageCode, Mode=TwoWay}"
                    SelectedValuePath="Code"
                    SelectionChanged="Language_SelectionChanged" />
            </Grid>
        </Border>

        <Border Grid.Row="5" Padding="16,12" Style="{StaticResource PanelBorderStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="9">
                    <Grid Width="10" Height="10" VerticalAlignment="Center">
                        <Ellipse
                            x:Name="SessionRunningDot"
                            Fill="{ThemeResource VoxLinkSuccessBrush}"
                            Visibility="Collapsed" />
                        <Ellipse
                            x:Name="SessionStoppedDot"
                            Fill="{ThemeResource VoxLinkMutedBrush}" />
                    </Grid>
                    <StackPanel>
                        <TextBlock x:Name="SessionStatusText" FontWeight="SemiBold" Text="准备中" />
                        <TextBlock
                            x:Name="ModelStatusText"
                            Style="{StaticResource CaptionStyle}"
                            Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
                <Button
                    x:Name="SessionButton"
                    Grid.Column="1"
                    MinWidth="120"
                    Click="SessionButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="SessionButtonIcon" FontSize="14" Glyph="&#xE768;" />
                        <TextBlock x:Name="SessionButtonText" Text="开始会话" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="6" Height="210" Padding="0" Style="{StaticResource PanelBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="16,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="最新消息" />
                        <TextBlock x:Name="MessageCountText" Style="{StaticResource CaptionStyle}" Text="0" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Background="Transparent"
                        Click="ViewHistory_Click"
                        ToolTipService.ToolTip="查看全部会话记录">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="13" Glyph="&#xE8A7;" />
                            <TextBlock Text="全部记录" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="2"
                        Background="Transparent"
                        Click="ClearMessages_Click"
                        ToolTipService.ToolTip="清空会话记录">
                        <SymbolIcon Symbol="Delete" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <StackPanel
                        x:Name="EmptyState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                        <FontIcon
                            FontSize="20"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE8BD;" />
                        <StackPanel Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="等待第一条消息" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="开始会话或在下方输入文字" />
                        </StackPanel>
                    </StackPanel>

                    <Grid
                        x:Name="LatestMessagePanel"
                        Margin="16,12"
                        ColumnSpacing="12"
                        Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="36"
                            Height="36"
                            VerticalAlignment="Top"
                            Background="{ThemeResource VoxLinkAccentSoftBrush}"
                            CornerRadius="{StaticResource VoxLinkRadiusSmall}">
                            <FontIcon
                                x:Name="LatestDirectionGlyph"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource VoxLinkAccentBrush}"
                                FontSize="16" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="LatestHeaderText" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock x:Name="LatestTimeText" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="LatestPrimaryText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="LatestSecondaryText" Foreground="{ThemeResource VoxLinkAccentBrush}" FontSize="13" TextWrapping="Wrap" />
                            <TextBlock x:Name="LatestSourceText" Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                        <Button
                            x:Name="LatestSpeakButton"
                            Grid.Column="2"
                            VerticalAlignment="Top"
                            Click="SpeakMessage_Click"
                            ToolTipService.ToolTip="朗读译文">
                            <FontIcon FontSize="14" Glyph="&#xE767;" />
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="7" Padding="12" Style="{StaticResource PanelBorderStyle}">
            <Grid ColumnSpacing="10" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource CaptionStyle}"
                    Text="Ctrl + Enter 发送" />
                <TextBox
                    x:Name="ComposerBox"
                    Grid.Row="0"
                    KeyDown="ComposerBox_KeyDown"
                    MinHeight="48"
                    PlaceholderText="输入要发送给对方的内容"
                    TextWrapping="NoWrap"
                    VerticalContentAlignment="Center" />
                <Button
                    x:Name="SubmitButton"
                    Grid.Row="0"
                    Grid.Column="1"
                    VerticalAlignment="Stretch"
                    MinWidth="130"
                    Click="SubmitButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE724;" />
                        <TextBlock x:Name="SubmitButtonText" Text="翻译并发送" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
