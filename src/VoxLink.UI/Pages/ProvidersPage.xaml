<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VoxLink.UI.Pages.ProvidersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:VoxLink.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d"
    NavigationCacheMode="Required">
    <ScrollViewer>
        <StackPanel Padding="24,20,24,28" Spacing="14">
            <StackPanel Spacing="3">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="AI 与语音" />
                <TextBlock
                    Style="{StaticResource CaptionStyle}"
                    Text="配置语音识别、翻译、文本生成与语音输出服务" />
            </StackPanel>

            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="默认本地识别不会上传音频。选择云端 ASR 后，只有明确允许上传才会发送原始音频；API Key 与请求头使用当前 Windows 用户加密存储。"
                Severity="Informational"
                Title="数据边界" />

            <InfoBar
                x:Name="ProviderErrorBar"
                IsClosable="True"
                IsOpen="False"
                Severity="Error"
                Closed="ProviderErrorBar_Closed" />

            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="翻译与文本生成" />
                            <TextBlock
                                x:Name="TranslationDescription"
                                Style="{StaticResource CaptionStyle}"
                                Text="默认免密翻译，失败时自动切换公共服务。" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Click="TestTranslation_Click"
                            ToolTipService.ToolTip="测试翻译服务">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon FontSize="13" Glyph="&#xE968;" />
                                <TextBlock Text="测试连接" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ComboBox
                        x:Name="TranslationBackendBox"
                        Header="服务提供方"
                        SelectionChanged="TranslationBackendBox_SelectionChanged">
                        <ComboBoxItem Content="公共免密（推荐）" Tag="PublicFree" />
                        <ComboBoxItem Content="阿里云 DashScope" Tag="DashScope" />
                        <ComboBoxItem Content="DeepSeek" Tag="DeepSeek" />
                        <ComboBoxItem Content="OpenAI 兼容" Tag="OpenAiCompatible" />
                        <ComboBoxItem Content="自定义服务" Tag="Custom" />
                    </ComboBox>

                    <StackPanel x:Name="TranslationCredentials" Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Header="服务地址"
                                PlaceholderText="https://api.example.com/v1"
                                Text="{x:Bind Controller.Settings.TranslationBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Grid.Column="1"
                                Header="模型"
                                PlaceholderText="模型名称"
                                Text="{x:Bind Controller.Settings.TranslationModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <PasswordBox
                            x:Name="TranslationApiKeyBox"
                            Header="API Key"
                            PasswordChanged="TranslationApiKeyBox_PasswordChanged"
                            PasswordRevealMode="Peek"
                            PlaceholderText="密钥仅保存在当前 Windows 用户的加密存储中" />
                        <controls:HeaderEditor x:Name="TranslationHeaderEditor" />
                    </StackPanel>

                    <ToggleSwitch
                        x:Name="TranslationRefinementSwitch"
                        Header="使用当前 AI 服务润色译文"
                        IsOn="{x:Bind Controller.Settings.EnableTranslationRefinement, Mode=TwoWay}"
                        OffContent="关闭"
                        OnContent="开启"
                        Toggled="TranslationRefinementSwitch_Toggled" />
                    <TextBox
                        x:Name="TranslationRefinementPromptBox"
                        AcceptsReturn="True"
                        Header="润色要求"
                        MaxHeight="120"
                        PlaceholderText="例如：保持游戏术语，表达自然简洁"
                        Text="{x:Bind Controller.Settings.TranslationRefinementPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="语音识别" />
                            <TextBlock
                                x:Name="AsrDescription"
                                Style="{StaticResource CaptionStyle}"
                                Text="本地 Whisper 识别，原始音频不离开电脑。" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Click="PrepareAsr_Click"
                            ToolTipService.ToolTip="准备或验证语音识别">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon FontSize="13" Glyph="&#xE896;" />
                                <TextBlock Text="准备识别" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ComboBox
                        x:Name="AsrProviderBox"
                        Header="ASR 提供方"
                        SelectionChanged="AsrProviderBox_SelectionChanged">
                        <ComboBoxItem Content="本地 Whisper（推荐）" Tag="LocalWhisper" />
                        <ComboBoxItem Content="阿里云 DashScope 流式" Tag="DashScope" />
                        <ComboBoxItem Content="Soniox 流式" Tag="Soniox" />
                        <ComboBoxItem Content="硅基流动" Tag="SiliconFlow" />
                        <ComboBoxItem Content="小米 MiMo" Tag="MiMo" />
                        <ComboBoxItem Content="OpenAI 兼容" Tag="OpenAiCompatible" />
                        <ComboBoxItem Content="自定义服务" Tag="Custom" />
                    </ComboBox>

                    <StackPanel x:Name="AsrCloudCredentials" Spacing="12">
                        <ComboBox
                            x:Name="AsrProtocolBox"
                            Header="协议"
                            SelectionChanged="AsrProtocolBox_SelectionChanged">
                            <ComboBoxItem Content="本地 Whisper" Tag="LocalWhisper" />
                            <ComboBoxItem Content="DashScope WebSocket" Tag="DashScopeStreaming" />
                            <ComboBoxItem Content="Soniox WebSocket" Tag="SonioxStreaming" />
                            <ComboBoxItem Content="OpenAI multipart" Tag="OpenAiMultipart" />
                            <ComboBoxItem Content="MiMo input_audio" Tag="MiMoInputAudio" />
                        </ComboBox>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Header="服务地址"
                                PlaceholderText="https:// 或 wss://"
                                Text="{x:Bind Controller.Settings.AsrBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Grid.Column="1"
                                Header="模型"
                                PlaceholderText="ASR 模型名称"
                                Text="{x:Bind Controller.Settings.AsrModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <PasswordBox
                            x:Name="AsrApiKeyBox"
                            Header="API Key"
                            PasswordChanged="AsrApiKeyBox_PasswordChanged"
                            PasswordRevealMode="Peek"
                            PlaceholderText="密钥仅保存在当前 Windows 用户的加密存储中" />
                        <ToggleSwitch
                            Header="允许向所选云服务上传原始音频"
                            IsOn="{x:Bind Controller.Settings.AllowCloudAudioUpload, Mode=TwoWay}"
                            OffContent="禁止上传"
                            OnContent="允许上传" />
                        <controls:HeaderEditor x:Name="AsrHeaderEditor" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="语音输出" />
                            <TextBlock
                                x:Name="SpeechDescription"
                                Style="{StaticResource CaptionStyle}"
                                Text="默认使用 Edge、Google 与 Windows 本地语音回退。" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Click="TestSpeech_Click"
                            ToolTipService.ToolTip="测试语音输出">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon FontSize="13" Glyph="&#xE767;" />
                                <TextBlock Text="试听" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ToggleSwitch
                        x:Name="RemoteSpeechSwitch"
                        Header="使用远程语音服务"
                        IsOn="{x:Bind Controller.Settings.UseRemoteSpeech, Mode=TwoWay}"
                        Toggled="RemoteSpeechSwitch_Toggled" />

                    <StackPanel x:Name="SpeechCredentials" Spacing="12">
                        <ComboBox
                            x:Name="SpeechProtocolBox"
                            Header="协议"
                            SelectionChanged="SpeechProtocolBox_SelectionChanged">
                            <ComboBoxItem Content="阿里云 DashScope" Tag="DashScope" />
                            <ComboBoxItem Content="小米 MiMo" Tag="MiMo" />
                            <ComboBoxItem Content="OpenAI 兼容" Tag="OpenAiCompatible" />
                        </ComboBox>
                        <TextBox
                            Header="服务地址"
                            PlaceholderText="https://api.example.com/v1/audio/speech"
                            Text="{x:Bind Controller.Settings.SpeechBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Header="模型"
                                PlaceholderText="语音模型"
                                Text="{x:Bind Controller.Settings.SpeechModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Grid.Column="1"
                                Header="音色"
                                PlaceholderText="音色名称"
                                Text="{x:Bind Controller.Settings.SpeechVoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <PasswordBox
                            x:Name="SpeechApiKeyBox"
                            Header="API Key"
                            PasswordChanged="SpeechApiKeyBox_PasswordChanged"
                            PasswordRevealMode="Peek"
                            PlaceholderText="密钥仅保存在当前 Windows 用户的加密存储中" />
                        <controls:HeaderEditor x:Name="SpeechHeaderEditor" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
