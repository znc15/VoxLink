<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VoxLink.UI.Pages.ProvidersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d"
    NavigationCacheMode="Required">
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel Style="{StaticResource PageStackStyle}">
            <StackPanel Spacing="3">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="AI 与语音" />
                <TextBlock
                    Style="{StaticResource CaptionStyle}"
                    Text="切换翻译、语音识别与语音输出服务，并测试连接" />
            </StackPanel>

            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="关闭时使用公共免密翻译和本地 Whisper。服务提供方、地址、模型与凭据在「模型服务」页配置。"
                Severity="Informational" />

            <InfoBar
                x:Name="ProviderErrorBar"
                IsClosable="True"
                IsOpen="False"
                Severity="Error"
                Closed="ProviderErrorBar_Closed" />

            <InfoBar
                x:Name="ProviderResultBar"
                IsClosable="False"
                IsOpen="False"
                Severity="Success" />

            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="AI 翻译" />
                            <TextBlock
                                Style="{StaticResource CaptionStyle}"
                                Text="关闭时使用公共免密翻译。" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                            <ProgressRing
                                x:Name="TranslationTestProgress"
                                Width="20"
                                Height="20"
                                IsActive="False"
                                Visibility="Collapsed" />
                            <Button Click="TestTranslation_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon FontSize="13" Glyph="&#xE968;" />
                                    <TextBlock Text="测试连接" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ToggleSwitch
                        Header="使用 AI 翻译"
                        IsOn="{x:Bind Controller.Settings.UseAiTranslation, Mode=TwoWay}"
                        OffContent="公共免密"
                        OnContent="AI 服务" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="语音识别" />
                            <TextBlock
                                Style="{StaticResource CaptionStyle}"
                                Text="关闭时使用本地 Whisper，原始音频不上传。" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                            <ProgressRing
                                x:Name="AsrTestProgress"
                                Width="20"
                                Height="20"
                                IsActive="False"
                                Visibility="Collapsed" />
                            <Button Click="TestAsr_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon FontSize="13" Glyph="&#xE896;" />
                                    <TextBlock Text="测试连接" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ToggleSwitch
                        Header="使用云端语音识别"
                        IsOn="{x:Bind Controller.Settings.UseCloudAsr, Mode=TwoWay}"
                        OffContent="本地 Whisper"
                        OnContent="云端服务" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="语音输出" />
                            <TextBlock
                                Style="{StaticResource CaptionStyle}"
                                Text="试听会播放一句测试语音。" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                            <ProgressRing
                                x:Name="SpeechTestProgress"
                                Width="20"
                                Height="20"
                                IsActive="False"
                                Visibility="Collapsed" />
                            <Button Click="TestSpeech_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon FontSize="13" Glyph="&#xE767;" />
                                    <TextBlock Text="试听" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ToggleSwitch
                        Header="使用远程语音服务"
                        IsOn="{x:Bind Controller.Settings.UseRemoteSpeech, Mode=TwoWay}"
                        OffContent="本地语音"
                        OnContent="远程服务" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
