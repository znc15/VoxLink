<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VoxLink.UI.Pages.OverlayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d"
    NavigationCacheMode="Required">
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel Style="{StaticResource PageStackStyle}">
            <StackPanel Spacing="3">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="悬浮窗" />
                <TextBlock Style="{StaticResource CaptionStyle}" Text="翻译字幕的显示位置" />
            </StackPanel>

            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="在「VRChat」页开启「翻译对方语音」后，对方的译文会显示在这里；我自己的译文不会显示。"
                Severity="Informational"
                Title="显示内容" />

            <InfoBar
                x:Name="OverlayErrorBar"
                Closed="OverlayErrorBar_Closed"
                IsClosable="True"
                IsOpen="False"
                Severity="Error" />

            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="桌面字幕悬浮窗" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="默认固定在屏幕底部居中；关闭固定后可直接拖动或拉伸，位置和大小会自动保存。" />
                    </StackPanel>

                    <ToggleSwitch
                        Header="显示桌面字幕悬浮窗"
                        IsOn="{x:Bind Controller.Settings.ShowOverlay, Mode=TwoWay}"
                        OffContent="关闭"
                        OnContent="开启" />

                    <ToggleSwitch
                        Header="置顶显示"
                        IsOn="{x:Bind Controller.Settings.DesktopOverlayTopmost, Mode=TwoWay}"
                        OffContent="不置顶"
                        OnContent="置顶" />

                    <ComboBox
                        x:Name="DesktopDisplayModeBox"
                        Header="显示方式"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="DesktopDisplayModeBox_SelectionChanged">
                        <ComboBoxItem Content="永久显示（始终可见）" Tag="AlwaysVisible" />
                        <ComboBoxItem Content="自动隐藏" Tag="AutoHide" />
                    </ComboBox>

                    <StackPanel x:Name="AutoHideSecondsPanel" Spacing="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="无新字幕时自动隐藏（秒）" />
                            <TextBlock x:Name="DesktopAutoHideValueText" Grid.Column="1" Style="{StaticResource CaptionStyle}" />
                        </Grid>
                        <Slider
                            x:Name="DesktopAutoHideSlider"
                            Maximum="120"
                            Minimum="3"
                            SmallChange="1"
                            StepFrequency="1"
                            ValueChanged="DesktopAutoHideSlider_ValueChanged" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="自动隐藏模式下，收到新字幕会重新显示并重新计时。" />
                    </StackPanel>

                    <ToggleSwitch
                        Header="固定位置"
                        IsOn="{x:Bind Controller.Settings.DesktopOverlayLockPosition, Mode=TwoWay}"
                        OffContent="可拖动和调整大小"
                        OnContent="固定" />

                    <StackPanel Spacing="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="字幕宽度" />
                            <TextBlock x:Name="DesktopWidthValueText" Grid.Column="1" Style="{StaticResource CaptionStyle}" />
                        </Grid>
                        <Slider
                            x:Name="DesktopWidthSlider"
                            Maximum="1920"
                            Minimum="240"
                            SmallChange="20"
                            StepFrequency="20"
                            ValueChanged="DesktopSlider_ValueChanged" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="字幕字号" />
                            <TextBlock x:Name="DesktopFontSizeValueText" Grid.Column="1" Style="{StaticResource CaptionStyle}" />
                        </Grid>
                        <Slider
                            x:Name="DesktopFontSizeSlider"
                            Maximum="40"
                            Minimum="14"
                            SmallChange="1"
                            StepFrequency="1"
                            ValueChanged="DesktopSlider_ValueChanged" />
                    </StackPanel>

                    <Button
                        HorizontalAlignment="Left"
                        Click="ResetDesktopOverlay_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="13" Glyph="&#xE72C;" />
                            <TextBlock Text="重置位置与大小" />
                        </StackPanel>
                    </Button>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Click="TestDesktopOverlay_Click"
                            IsEnabled="{x:Bind Controller.EngineConnected, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon FontSize="13" Glyph="&#xE7F4;" />
                                <TextBlock Text="测试桌面字幕" />
                            </StackPanel>
                        </Button>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionStyle}"
                            Text="{x:Bind Controller.TestResultMessage, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="SteamVR 头显字幕" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="SteamVR Overlay 需要 SteamVR 正在运行并检测到头显。桌面模式和原生 Oculus/OpenXR 不使用此输出。" />
                    </StackPanel>

                    <ToggleSwitch
                        Header="SteamVR 头显字幕"
                        IsOn="{x:Bind Controller.Settings.ShowVrOverlay, Mode=TwoWay}"
                        OffContent="关闭"
                        OnContent="开启" />

                    <Button
                        HorizontalAlignment="Left"
                        Click="TestVrOverlay_Click"
                        IsEnabled="{x:Bind Controller.EngineConnected, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="13" Glyph="&#xE7F4;" />
                            <TextBlock Text="测试头显字幕" />
                        </StackPanel>
                    </Button>

                    <StackPanel Spacing="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="字幕宽度" />
                            <TextBlock x:Name="WidthValueText" Grid.Column="1" Style="{StaticResource CaptionStyle}" />
                        </Grid>
                        <Slider
                            x:Name="WidthSlider"
                            Maximum="3"
                            Minimum="0.6"
                            SmallChange="0.1"
                            StepFrequency="0.1"
                            ValueChanged="OverlaySlider_ValueChanged" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="观看距离" />
                            <TextBlock x:Name="DistanceValueText" Grid.Column="1" Style="{StaticResource CaptionStyle}" />
                        </Grid>
                        <Slider
                            x:Name="DistanceSlider"
                            Maximum="4"
                            Minimum="0.6"
                            SmallChange="0.1"
                            StepFrequency="0.1"
                            ValueChanged="OverlaySlider_ValueChanged" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="垂直位置" />
                            <TextBlock x:Name="VerticalValueText" Grid.Column="1" Style="{StaticResource CaptionStyle}" />
                        </Grid>
                        <Slider
                            x:Name="VerticalSlider"
                            Maximum="0.5"
                            Minimum="-1"
                            SmallChange="0.05"
                            StepFrequency="0.05"
                            ValueChanged="OverlaySlider_ValueChanged" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
