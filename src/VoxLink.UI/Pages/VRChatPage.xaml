<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VoxLink.UI.Pages.VRChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d"
    NavigationCacheMode="Required">
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel Style="{StaticResource PageStackStyle}">
            <StackPanel Spacing="3">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="VRChat" />
                <TextBlock Style="{StaticResource CaptionStyle}" Text="翻译对方语音、Chatbox 消息与静音联动" />
            </StackPanel>

            <InfoBar
                x:Name="VrChatErrorBar"
                Closed="VrChatErrorBar_Closed"
                IsClosable="True"
                IsOpen="False"
                Severity="Error" />

            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="翻译对方语音" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="识别 VRChat 中对方说的话并翻译，译文显示在「悬浮窗」页的悬浮窗中；不会发送到 Chatbox。" />
                    </StackPanel>

                    <ToggleSwitch
                        x:Name="VoiceTranslationSwitch"
                        Header="翻译对方语音"
                        IsOn="{x:Bind Controller.Settings.CaptureSystemAudio, Mode=TwoWay}"
                        OffContent="关闭"
                        OnContent="开启" />

                    <InfoBar
                        x:Name="RestartHintBar"
                        IsClosable="False"
                        IsOpen="False"
                        Message="采集来源已更改，重新开始会话后生效。"
                        Severity="Warning" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="说话人标签" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="在译文中标注这句话是谁说的（本地识别为 A / B / C）。" />
                    </StackPanel>

                    <ToggleSwitch
                        x:Name="SpeakerLabelSwitch"
                        Header="显示说话人标签"
                        OffContent="关闭"
                        OnContent="开启"
                        Toggled="SpeakerLabelSwitch_Toggled" />

                    <InfoBar
                        x:Name="LocalSpeakerInfo"
                        IsClosable="False"
                        IsOpen="False"
                        Message="首次启用时下载约 27 MB 的本地说话人模型（sherpa-onnx CAMPPlus），模型仅保存在本机；使用 Soniox 云端识别时自动改用云端说话人 ID。"
                        Severity="Informational" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="OSC Chatbox" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="发送我的麦克风译文和手动输入译文；不会发送他人语音译文。" />
                    </StackPanel>

                    <ToggleSwitch
                        Header="发送到 VRChat Chatbox"
                        IsOn="{x:Bind Controller.Settings.VrChatChatboxEnabled, Mode=TwoWay}"
                        OffContent="关闭"
                        OnContent="开启" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Header="目标 IPv4 地址"
                            PlaceholderText="127.0.0.1"
                            Text="{x:Bind Controller.Settings.VrChatOscAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <NumberBox
                            x:Name="OscPortNumberBox"
                            Grid.Column="1"
                            Header="目标端口"
                            Maximum="65535"
                            Minimum="1"
                            SmallChange="1"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="OscPortNumberBox_ValueChanged" />
                    </Grid>

                    <ToggleSwitch
                        Header="同时发送原文"
                        IsOn="{x:Bind Controller.Settings.VrChatIncludeSourceText, Mode=TwoWay}"
                        OffContent="仅译文"
                        OnContent="原文与译文" />

                    <Button
                        HorizontalAlignment="Left"
                        Click="TestOsc_Click"
                        IsEnabled="{x:Bind Controller.EngineConnected, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="13" Glyph="&#xE724;" />
                            <TextBlock Text="发送测试消息" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="麦克风静音联动" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="监听本机 VRChat OSC 的 /avatar/parameters/MuteSelf；静音时只暂停 VoxLink 麦克风，系统回环继续工作。" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="MuteSelfSwitch"
                        Header="跟随 VRChat MuteSelf"
                        IsOn="{x:Bind Controller.Settings.VrChatMuteSelfEnabled, Mode=TwoWay}"
                        OffContent="关闭"
                        OnContent="开启"
                        Toggled="MuteSelfSwitch_Toggled" />
                    <Grid x:Name="MuteSelfEndpoint" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Header="监听 IPv4 地址"
                            PlaceholderText="127.0.0.1"
                            Text="{x:Bind Controller.Settings.VrChatOscListenAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <NumberBox
                            x:Name="OscListenPortNumberBox"
                            Grid.Column="1"
                            Header="监听端口"
                            Maximum="65535"
                            Minimum="1"
                            SmallChange="1"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="OscListenPortNumberBox_ValueChanged" />
                    </Grid>
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="VRChat OSC 入站端口通常为 9001。更改监听配置后请重新开始会话。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
