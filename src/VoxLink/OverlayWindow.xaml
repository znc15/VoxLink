<Window x:Class="VoxLink.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="760"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        MinWidth="240"
        MinHeight="88"
        MouseLeftButtonDown="OverlayWindow_MouseLeftButtonDown">
    <Grid>
        <Border x:Name="SubtitleSurface"
                Margin="18"
                Padding="24,17"
                Background="#E6192220"
                BorderBrush="#6AFFFFFF"
                BorderThickness="1"
                CornerRadius="7">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="HeaderTextBlock"
                           Foreground="#AFFFFFFF"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextAlignment="Center" />
                <TextBlock x:Name="TranslatedTextBlock"
                           Grid.Row="1"
                           Margin="0,5,0,0"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="SecondaryTextBlock"
                           Grid.Row="2"
                           Margin="0,5,0,0"
                           Foreground="#B9B9FFF1"
                           FontSize="17"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="SourceTextBlock"
                           Grid.Row="3"
                           Margin="0,7,0,0"
                           Foreground="#C5FFFFFF"
                           FontSize="14"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>
        <Thumb x:Name="ResizeThumb"
               Width="18"
               Height="18"
               Margin="0,0,10,10"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Cursor="SizeNWSE"
               DragCompleted="ResizeThumb_DragCompleted"
               DragDelta="ResizeThumb_DragDelta"
               Visibility="Collapsed">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Path
                            Data="M 0,6 L 6,0 M 0,12 L 12,0 M 6,18 L 18,6 M 0,18 L 18,0"
                            Stroke="#BFFFFFFF"
                            StrokeThickness="1.5" />
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</Window>
